{
  "name": "calendar-sales-management-system",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Ready Calendar Sales Management System with Malayalam Support",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,CLIENT\" -c \"cyan.bold,green.bold\" \"npm run server\" \"npm run client\"",
    "prisma:generate": "npm run prisma:generate --prefix server",
    "prisma:push": "npm run prisma:push --prefix server",
    "seed": "npm run seed --prefix server",
    "test": "npm test --prefix server",
    "build:server": "npm run build --prefix server",
    "build:client": "npm run build --prefix client",
    "build": "npm run prisma:generate && npm run build:client && npm run build:server",
    "server": "npm run dev --prefix server",
    "client": "npm run dev --prefix client",
    "start": "node server/scripts/start.js"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
