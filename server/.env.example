# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# For SQLite (default out of the box):
DATABASE_URL="file:./dev.db"

# For PostgreSQL / Supabase:
# DATABASE_URL="postgresql://postgres:yourpassword@localhost:5432/calendar_sales_db?schema=public"

# Authentication
JWT_SECRET=replace-with-a-very-long-random-secret-key-in-production
JWT_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173
